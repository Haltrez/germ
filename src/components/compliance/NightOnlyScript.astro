---
/**
 * Reveals [data-ad-time-restricted] elements only 21:00–06:00 Europe/Berlin
 * (GlüStV 2021 § 5 Abs. 3). Sets window.__ksaAdsAllowed for scripts.
 */
import { ADS } from '../../config/site.ts';
---
<script is:inline set:html={`(function(){var f=${ADS.blockedFromHour},u=${ADS.blockedUntilHour},on=${ADS.virtualSlotAdsNightOnly ? 'true' : 'false'};function a(){var h=Number(new Intl.DateTimeFormat('en-GB',{hour:'2-digit',hourCycle:'h23',timeZone:'Europe/Berlin'}).formatToParts(new Date()).find(function(x){return x.type==='hour'}).value);var ok=!on||!(h>=f&&h<u);window.__ksaAdsAllowed=ok;document.querySelectorAll('[data-ad-time-restricted="true"]').forEach(function(e){if(!e.hasAttribute('data-ad-manual'))e.hidden=!ok;});document.querySelectorAll('[data-day-only]').forEach(function(e){e.hidden=ok;});}a();setInterval(a,60000);})();`} />
