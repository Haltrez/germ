---
import { RG } from '../../config/site.ts';
---
<section class="container-site py-12" aria-label="Verantwortungsvoll spielen">
  <div class="flex flex-col items-start gap-5 rounded-2xl border border-line bg-ink-900/70 p-6 sm:flex-row sm:items-center">
    <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-coral-400 font-display text-xl text-coral-300">{RG.minAge}+</span>
    <p class="flex-1 text-muted">
      <strong class="text-fg">Spiel mit Limit.</strong> Glücksspiel kann süchtig machen. Setz dir vorher ein Budget und hör auf, wenn es aufgebraucht ist.
      Kostenlose, anonyme Hilfe: <a href={RG.helplinePhoneHref} class="whitespace-nowrap text-fg underline underline-offset-2">{RG.helplinePhone}</a>.
    </p>
    <a href={RG.rgPagePath} class="btn-ghost shrink-0">Verantwortungsvoll spielen</a>
  </div>
</section>
