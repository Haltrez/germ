---
/**
 * Demo facade: nothing third-party loads until the visitor clicks.
 * - Needs "Externe Medien" consent; if missing, an inline prompt lets the visitor
 *   allow it once (as easy to decline as to accept: just don't click).
 * - Without an official demo URL a fallback with game info is shown.
 */
import SlotArt from './SlotArt.astro';
import { DEMO_HOST_ALLOWLIST } from '../../config/site.ts';
import type { SlotView } from '../../lib/slots.ts';
import type { RealMoneyOp } from '../../lib/realmoney.ts';
import { RG } from '../../config/site.ts';
interface Props { slot: SlotView; realMoney?: RealMoneyOp[] }
const { slot, realMoney = [] } = Astro.props;
const first = realMoney[0];
const { demoUrl, demoVersionUrl, demoSourceName, name } = slot.data;
---
<section id="demo" aria-label={`${name} Demo`} class="card relative scroll-mt-20 overflow-hidden p-0">
  <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-2.5 text-xs">
    <h2 class="font-title text-sm font-bold text-fg">{demoUrl ? `${name} Demo` : `${name} · Demo folgt`}</h2>
    {demoUrl && (
      <button type="button" class="btn btn-secondary !min-h-9 !rounded-lg !px-3 !py-1 text-xs" data-demo-fs>
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" /></svg>
        <span data-fs-label>Vollbild</span>
      </button>
    )}
  </div>

  <div class="relative aspect-[16/10] w-full bg-ink-950" data-demo-root data-demo-url={demoUrl ?? undefined} data-demo-version-url={demoVersionUrl} data-demo-hosts={DEMO_HOST_ALLOWLIST.join(' ')}>
    {slot.data.thumbnail
      ? <img src={slot.data.thumbnail.src} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-md" />
      : <div class="absolute inset-0 opacity-40 blur-[2px]"><SlotArt slug={slot.id} name={name} large class="!aspect-auto h-full !rounded-none" /></div>}
    {slot.data.thumbnail && <img src={slot.data.thumbnail.src} alt={slot.data.thumbnail.alt} class="absolute inset-0 m-auto max-h-[70%] max-w-[60%] rounded-xl object-contain opacity-90 shadow-2xl" />}
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950/90 via-ink-950/30 to-transparent"></div>

    {demoUrl ? (
      <div class="absolute inset-x-0 bottom-0 flex flex-col items-center justify-end gap-3 p-6 text-center" data-demo-facade>
        <button type="button" class="btn btn-primary !min-h-12 !px-6 text-base" data-demo-start>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor" /></svg>
          Demo spielen
        </button>
        <p class="hidden max-w-sm text-xs text-muted" data-demo-consent-note>
          Lädt die Demo von {demoSourceName ?? 'dem Hersteller'} (<a href="/datenschutz/" class="underline underline-offset-2 hover:text-fg">Datenschutz</a>).
        </p>
      </div>
    ) : (
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-6 text-center">
        <p class="font-display text-xl font-bold text-fg">Demo derzeit nicht verfügbar</p>
        <p class="max-w-md text-sm text-muted">
          Für {name} binden wir nur offizielle Demos des Herstellers ein. Sobald eine geprüfte Demo verfügbar ist, kannst du
          hier mit Spielgeld spielen. Bis dahin findest du unten alle Daten zum Spiel.
        </p>
      </div>
    )}
  </div>

  {demoUrl && first && (
    <div class="absolute inset-0 z-20 flex items-center justify-center bg-ink-950/70 p-4 backdrop-blur-sm" data-rm-prompt data-ad-unit="virtual-slot" data-ad-time-restricted="true" data-ad-manual hidden role="dialog" aria-modal="true" aria-labelledby="rm-title" data-rm-ops={JSON.stringify(realMoney)}>
      <div class="card w-full max-w-sm p-5 text-center shadow-2xl">
        <p class="text-[0.6875rem] font-semibold uppercase tracking-wider text-subtle">Anzeige</p>
        <p id="rm-title" class="mt-1 font-title text-xl font-bold text-fg">{name} mit Echtgeld spielen?</p>
        <div class="mt-4 flex items-center justify-center gap-3">
          <img src={first.logo ?? ''} alt="" width="56" height="56" class="h-14 w-14 rounded-xl object-contain" data-rm-logo hidden={!first.logo} />
          <div class="text-left">
            <p class="font-semibold text-fg" data-rm-name>{first.name}</p>
            <p class="text-xs text-gold-400" data-rm-tag>{first.tag}</p>
          </div>
        </div>
        <a href={first.href} rel={first.rel} target="_blank" class="btn btn-primary mt-4 w-full !min-h-12 text-base" data-rm-link>Echtgeld-Version ansehen</a>
        <button type="button" class="btn btn-secondary mt-2 w-full" data-rm-close>Weiter mit Spielgeld</button>
        <p class="mt-3 text-[0.6875rem] text-subtle">Nur Spielotheken mit GGL-Erlaubnis · {RG.minAge}+ · Glücksspiel kann süchtig machen · Hilfe: {RG.helplinePhone}</p>
      </div>
    </div>
  )}
</section>

<script>
  /** Every 90 s of demo play, offer the real-money version at a rotating GGL operator (night hours only). */
  function startRealMoneyPrompt(section: Element | null) {
    const prompt = section?.querySelector<HTMLElement>('[data-rm-prompt]');
    if (!prompt) return;
    const ops = JSON.parse(prompt.dataset.rmOps ?? '[]') as { name: string; logo: string | null; tag: string | null; href: string; rel: string; affiliate: boolean; id: string }[];
    if (!ops.length) return;
    let idx = 0;
    try { idx = (Number(sessionStorage.getItem('ksa-rm-idx')) || Math.floor(Math.random() * ops.length)) % ops.length; } catch { idx = Math.floor(Math.random() * ops.length); }
    const link = prompt.querySelector<HTMLAnchorElement>('[data-rm-link]')!;
    const logo = prompt.querySelector<HTMLImageElement>('[data-rm-logo]')!;
    const show = () => {
      if (!prompt.hidden || !(window as unknown as { __ksaAdsAllowed?: boolean }).__ksaAdsAllowed) return;
      const o = ops[idx % ops.length];
      idx = (idx + 1) % ops.length;
      try { sessionStorage.setItem('ksa-rm-idx', String(idx)); } catch { /* ignore */ }
      prompt.querySelector('[data-rm-name]')!.textContent = o.name;
      prompt.querySelector('[data-rm-tag]')!.textContent = o.tag ?? '';
      if (o.logo) { logo.src = o.logo; logo.hidden = false; } else logo.hidden = true;
      link.href = o.href;
      link.rel = o.rel;
      if (o.affiliate) link.dataset.affiliate = o.id; else delete link.dataset.affiliate;
      prompt.hidden = false;
    };
    const hide = () => { prompt.hidden = true; };
    prompt.querySelector('[data-rm-close]')?.addEventListener('click', hide);
    link.addEventListener('click', () => setTimeout(hide, 300));
    setInterval(show, 90_000);
  }
  type ConsentApi = { has: (c: 'media') => boolean; grant: (c: 'media') => void };
  document.querySelectorAll<HTMLElement>('[data-demo-root]').forEach((root) => {
    const url = root.dataset.demoUrl;
    const btn = root.querySelector<HTMLButtonElement>('[data-demo-start]');
    if (!url || !btn) return;
    const api = () => (window as unknown as { KSAConsent?: ConsentApi }).KSAConsent;
    if (!api()?.has('media')) root.querySelector('[data-demo-consent-note]')?.classList.remove('hidden');
    btn.addEventListener('click', async () => {
      if (!api()?.has('media')) api()?.grant('media');
      btn.disabled = true;
      let src = url;
      try {
        const versionUrl = root.dataset.demoVersionUrl;
        if (versionUrl) {
          const res = await fetch(versionUrl, { cache: 'no-store' });
          const v = String((await res.json()).version ?? '');
          if (!/^[\w.-]{1,40}$/.test(v)) throw new Error('bad version');
          src = src.replace('{version}', v);
        }
        if (window.matchMedia('(max-width: 768px)').matches) src = src.replace('channel=desktop', 'channel=mobile');
        const host = new URL(src).hostname;
        const allowed = (root.dataset.demoHosts ?? '').split(' ').filter(Boolean);
        if (!allowed.includes(host)) throw new Error('host not allowed');
      } catch {
        btn.disabled = false;
        const note = root.querySelector('[data-demo-consent-note]');
        if (note) { note.textContent = 'Die Demo konnte gerade nicht geladen werden. Bitte versuch es später noch einmal.'; note.classList.remove('hidden'); }
        return;
      }
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'Spielgeld-Demo';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      iframe.allow = 'fullscreen; autoplay';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      root.replaceChildren(iframe);
      startRealMoneyPrompt(root.closest('section'));
      root.focus();
    });
  });

  // Fullscreen: native API where available (desktop, Android), CSS overlay fallback (iOS Safari).
  document.querySelectorAll<HTMLButtonElement>('[data-demo-fs]').forEach((fsBtn) => {
    const section = fsBtn.closest<HTMLElement>('#demo')!;
    const label = fsBtn.querySelector('[data-fs-label]')!;
    const setLabel = (on: boolean) => { label.textContent = on ? 'Schließen' : 'Vollbild'; };
    const pseudoOff = () => { section.classList.remove('demo-pseudo-fs'); document.documentElement.style.overflow = ''; setLabel(false); };
    fsBtn.addEventListener('click', () => {
      if (document.fullscreenElement) { document.exitFullscreen(); return; }
      if (section.classList.contains('demo-pseudo-fs')) { pseudoOff(); return; }
      section.querySelector<HTMLButtonElement>('[data-demo-start]')?.click();
      const el = section as HTMLElement & { webkitRequestFullscreen?: () => void };
      if (el.requestFullscreen && document.fullscreenEnabled) {
        el.requestFullscreen().catch(() => { section.classList.add('demo-pseudo-fs'); document.documentElement.style.overflow = 'hidden'; setLabel(true); });
      } else {
        section.classList.add('demo-pseudo-fs'); document.documentElement.style.overflow = 'hidden'; setLabel(true);
      }
    });
    document.addEventListener('fullscreenchange', () => setLabel(document.fullscreenElement === section));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && section.classList.contains('demo-pseudo-fs')) pseudoOff(); });
  });

  // Mobile CTA bar "Demo spielen": scroll and start.
  document.querySelector('[data-mobile-demo]')?.addEventListener('click', (e) => {
    e.preventDefault();
    const sec = document.getElementById('demo');
    sec?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    sec?.querySelector<HTMLButtonElement>('[data-demo-start]')?.click();
  });

  // Arrived via "Zufallsslot": start right away if external media is already allowed.
  window.addEventListener('load', () => {
    if (!new URLSearchParams(location.search).has('zufall')) return;
    const root = document.querySelector<HTMLElement>('[data-demo-root]');
    const btn = root?.querySelector<HTMLButtonElement>('[data-demo-start]');
    root?.closest('section')?.scrollIntoView({ block: 'start' });
    const api = (window as unknown as { KSAConsent?: { has: (c: 'media') => boolean } }).KSAConsent;
    if (btn && api?.has('media')) btn.click();
    else btn?.focus();
  });
</script>

<style is:global>
  #demo:fullscreen, #demo.demo-pseudo-fs { display: flex; flex-direction: column; border-radius: 0; background: #000; }
  #demo.demo-pseudo-fs { position: fixed; inset: 0; z-index: 100; }
  #demo:fullscreen [data-demo-root], #demo.demo-pseudo-fs [data-demo-root] { aspect-ratio: auto; flex: 1; }
</style>
