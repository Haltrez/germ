---
/** "Echtgeld-Version" box above the review: up to 4 GGL-verified Spielotheken. */
import type { RealMoneyOp } from '../../lib/realmoney.ts';
import { RG } from '../../config/site.ts';
interface Props { name: string; ops: RealMoneyOp[]; class?: string; headingId?: string; columns?: 1 | 2 }
const { name, ops, class: cls = 'mt-14', headingId = 'realmoney-title', columns = 2 } = Astro.props;
---
{ops.length > 0 && (
  <section class:list={['card border-gold-500/60 p-5 shadow-[0_0_40px_-12px_rgba(245,197,66,0.45)] sm:p-6', cls]} aria-labelledby={headingId} data-ad-unit="virtual-slot" data-ad-time-restricted="true" hidden>
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id={headingId} class="font-title text-xl font-bold text-fg sm:text-2xl">{name} um Echtgeld spielen</h2>
      <span class="text-[0.6875rem] font-semibold uppercase tracking-wider text-subtle">Anzeige</span>
    </div>
    <p class="mt-1 text-sm text-muted">Nur Online-Spielotheken mit Erlaubnis der GGL. Max. 1 € pro Spin, 5 Sekunden pro Runde.</p>
    <ul class:list={['mt-4 grid gap-3', columns === 2 && 'lg:grid-cols-2']}>
      {ops.map((o) => (
        <li class="flex flex-wrap items-center gap-3 rounded-xl border border-line bg-ink-950/50 p-3 sm:flex-nowrap">
          {o.logo && <img src={o.logo} alt={`${o.name} Logo`} width="56" height="56" class="h-14 w-14 shrink-0 rounded-lg object-contain" />}
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-fg">{o.name}</p>
            {o.tag && <p class="truncate text-xs text-gold-400">{o.tag}</p>}
          </div>
          <a href={o.href} rel={o.rel} target="_blank" data-affiliate={o.affiliate ? o.id : undefined} class="btn btn-primary !min-h-12 w-full shrink-0 !px-5 text-base sm:w-auto">Echtgeld-Version ansehen</a>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-xs text-subtle" data-affiliate-disclosure>
      Anzeige: Wir erhalten ggf. eine Provision. {RG.minAge}+ · Glücksspiel kann süchtig machen · Hilfe: <a href={RG.helplinePhoneHref} class="underline">{RG.helplinePhone}</a>
    </p>
  </section>
)}
