---
import { SITE_NAME } from '../../config/site.ts';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href="/" class:list={['group inline-flex items-center rounded-lg', cls]} aria-label={`${SITE_NAME} – zur Startseite`}>
  <span class="flex flex-col font-display text-[1.05rem] uppercase leading-[0.95] tracking-wide min-[420px]:block min-[420px]:text-[1.35rem] min-[420px]:leading-none sm:text-[1.6rem]">
    <span class="text-fg">Kostenlose</span><span class="text-gold-400">Spielautomaten</span>
  </span>
</a>
