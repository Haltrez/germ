---
import { SITE_NAME } from '../../config/site.ts';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href="/" class:list={['group inline-flex items-center gap-2.5 rounded-lg', cls]} aria-label={`${SITE_NAME} – zur Startseite`}>
  <svg width="36" height="36" viewBox="0 0 40 40" aria-hidden="true" class="shrink-0">
    <defs>
      <linearGradient id="lg-logo" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#4eeabb" />
        <stop offset="1" stop-color="#7b66f5" />
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="38" height="38" rx="11" fill="url(#lg-logo)" />
    <rect x="7" y="9" width="7" height="22" rx="3.5" fill="#050a1c" opacity=".9" />
    <rect x="16.5" y="9" width="7" height="22" rx="3.5" fill="#050a1c" opacity=".9" />
    <rect x="26" y="9" width="7" height="22" rx="3.5" fill="#050a1c" opacity=".9" />
    <circle cx="10.5" cy="17" r="2.2" fill="#ffc857" />
    <path d="M20 21.6l2.3 2.3-2.3 2.3-2.3-2.3z" fill="#4eeabb" />
    <circle cx="29.5" cy="22" r="2.2" fill="#c3b8ff" />
  </svg>
  <span class="font-display text-[1.05rem] font-extrabold leading-none tracking-tight sm:text-lg">
    <span class="text-fg">Kostenlose</span><span class="text-mint-400">Spielautomaten</span>
  </span>
</a>
