---
import Logo from './Logo.astro';
import { FOOTER_LEGAL } from '../../config/routes.ts';
import { RG, SITE_NAME } from '../../config/site.ts';

const columns = [
  {
    title: 'Spielen',
    links: [
      { label: 'Spielhalle', href: '/spielautomaten/' },
      { label: 'Ranglisten', href: '/ranglisten/' },
      { label: 'Hersteller', href: '/hersteller/' },
      { label: 'Tools', href: '/tools/' },
    ],
  },
  {
    title: 'Wissen',
    links: [
      { label: 'Ratgeber', href: '/ratgeber/' },
      { label: 'Glossar', href: '/glossar/' },
      { label: 'Spielotheken mit GGL-Lizenz', href: '/echtgeld-spielotheken/' },
      { label: 'So prüfen wir', href: '/bewertungsmethodik/' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-line bg-ink-900/60">
  <div class="container-site grid gap-10 py-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-sm text-sm text-muted">
        Kostenlose Spielautomaten als Spielgeld-Demo, ehrliche Daten zu jedem Slot und ein Vergleich ausschließlich
        von Online-Spielotheken mit deutscher GGL-Erlaubnis.
      </p>
      <p class="mt-4 text-xs text-subtle">
        Wir sind kein Glücksspielanbieter und nehmen keine Einsätze an. Einige Links sind Affiliate-Links.{' '}
        <a href="/affiliate-hinweis/" class="underline underline-offset-2 hover:text-fg">Wie wir Geld verdienen</a>
      </p>
    </div>

    {columns.map((col) => (
      <div>
        <p class="font-display text-sm font-bold uppercase tracking-wider text-fg">{col.title}</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {col.links.map((l) => (<li><a href={l.href} class="text-muted hover:text-fg">{l.label}</a></li>))}
        </ul>
      </div>
    ))}

    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wider text-fg">Rechtliches</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {FOOTER_LEGAL.map((l) => (<li><a href={l.href} class="text-muted hover:text-fg">{l.label}</a></li>))}
        <li>
          <button type="button" data-open-consent class="text-left text-muted underline-offset-2 hover:text-fg hover:underline">Cookie-Einstellungen</button>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line" data-rg-notice>
    <div class="container-site flex flex-col gap-4 py-6 text-xs text-subtle md:flex-row md:items-center md:justify-between">
      <div class="flex items-start gap-3">
        <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-coral-400 font-display text-[0.7rem] font-extrabold text-coral-300" aria-hidden="true">{RG.minAge}+</span>
        <p class="max-w-2xl">
          <strong class="text-muted">Glücksspiel ab {RG.minAge} Jahren. Glücksspiel kann süchtig machen.</strong>{' '}
          Hilfe und Beratung erhältst du kostenlos und anonym unter{' '}
          <a href={RG.helplinePhoneHref} class="whitespace-nowrap underline underline-offset-2 hover:text-fg">{RG.helplinePhone}</a>{' '}
          und auf <a href={RG.helplineUrl} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-fg">{RG.helplineUrlLabel}</a>.
          Mehr zu OASIS, LUGAS und Limits: <a href={RG.rgPagePath} class="underline underline-offset-2 hover:text-fg">Verantwortungsvoll spielen</a>.
        </p>
      </div>
      <p class="shrink-0">© {year} {SITE_NAME}</p>
    </div>
  </div>
</footer>
