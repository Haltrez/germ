---
/** Sticky bottom CTA bar on phones: "Demo spielen" on slot pages, otherwise the Spielotheken comparison. */
interface Props { slotName?: string }
const { slotName } = Astro.props;
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-ink-950/95 px-4 py-2.5 backdrop-blur-md md:hidden" data-mobile-bar>
  {slotName ? (
    <div class="flex items-center gap-3">
      <p class="min-w-0 flex-1 truncate font-title text-sm font-bold text-fg">{slotName}</p>
      <a href="#demo" class="btn btn-primary !min-h-11 !px-5 text-sm" data-mobile-demo>Demo spielen</a>
    </div>
  ) : (
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1 leading-tight">
        <p class="truncate font-title text-sm font-bold text-fg">Spielotheken mit deutscher Lizenz</p>
        <p class="truncate text-xs text-subtle">Geprüft auf der GGL-Whitelist</p>
      </div>
      <a href="/echtgeld-spielotheken/" class="btn btn-primary !min-h-11 !px-5 text-sm">Vergleichen</a>
    </div>
  )}
</div>
