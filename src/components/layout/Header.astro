---
import Logo from './Logo.astro';
import { NAV, isLive } from '../../config/routes.ts';
const nav = NAV.filter((i) => isLive(i.href)).map((i) => ({ ...i, children: i.children?.filter((c) => isLive(c.href)) }));

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-line/80 bg-ink-950/85 backdrop-blur-md">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <Logo />

    <nav aria-label="Hauptnavigation" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li class="group relative">
            <a
              href={item.href}
              class:list={[
                'inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-sm font-semibold transition-colors',
                isActive(item.href) ? 'bg-white/5 text-fg' : 'text-muted hover:text-fg',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
              {item.children && (
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="opacity-60"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /></svg>
              )}
            </a>
            {item.children && (
              <div class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <ul class="card w-60 p-2">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class="block rounded-xl px-3 py-2 text-sm text-muted hover:bg-white/5 hover:text-fg">{c.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/spielautomaten/#suche" class="btn btn-secondary hidden !min-h-10 !px-3.5 sm:inline-flex" aria-label="Slot suchen">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none" /><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span class="hidden xl:inline">Slot suchen</span>
      </a>
      <button
        type="button"
        class="btn btn-secondary !min-h-10 !px-3 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span class="sr-only">Menü öffnen</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Mobile Navigation" class="border-t border-line bg-ink-950 lg:hidden" hidden>
    <ul class="container-site space-y-1 py-4">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="block rounded-xl px-3 py-3 font-semibold text-fg hover:bg-white/5">{item.label}</a>
          {item.children && (
            <ul class="mb-2 ml-3 grid grid-cols-2 gap-1 border-l border-line pl-3">
              {item.children.map((c) => (
                <li><a href={c.href} class="block rounded-lg px-2 py-2 text-sm text-muted hover:text-fg">{c.label}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
    const label = btn.querySelector('.sr-only');
    if (label) label.textContent = open ? 'Menü öffnen' : 'Menü schließen';
  });
</script>
