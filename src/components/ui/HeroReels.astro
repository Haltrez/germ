---
/**
 * Animated hero slot box: three reels spin and land on 7-7-7 (pure CSS, original artwork).
 * Reduced motion: shows the landed state without animation.
 */
import RandomDemoButton from './RandomDemoButton.astro';

type Sym = 'seven' | 'diamond' | 'star' | 'bar' | 'cherry';
const pool: Sym[] = ['diamond', 'star', 'bar', 'cherry'];
// Each strip: random-looking symbols, ending with [above, SEVEN, below] as the final visible 3.
const strip = (seed: number): Sym[] => {
  const out: Sym[] = [];
  for (let i = 0; i < 15; i++) out.push(i % 5 === 2 ? 'seven' : pool[(i * 7 + seed) % pool.length]);
  return [...out, pool[seed % pool.length], 'seven', pool[(seed + 2) % pool.length]];
};
const reels = [strip(1), strip(2), strip(3)];
---
<div class="hero-reels card relative overflow-hidden rounded-[1.6rem] border-gold-500/30 p-5 sm:p-6">
  <div class="pointer-events-none absolute -top-24 left-1/2 h-48 w-72 -translate-x-1/2 rounded-full bg-gold-400/20 blur-3xl" aria-hidden="true"></div>
  <p class="text-center text-xs font-bold uppercase tracking-[0.18em] text-gold-400">Dein Zufallsslot</p>

  <div class="reels relative mt-4 grid grid-cols-3 gap-3 rounded-2xl bg-ink-950/70 p-3" aria-hidden="true">
    {reels.map((syms, r) => (
      <div class="reel-window overflow-hidden rounded-xl bg-ink-900">
        <div class:list={['reel-strip', `reel-${r + 1}`]}>
          {syms.map((sym) => (
            <div class="reel-cell flex items-center justify-center">
              <svg viewBox="0 0 48 48" class="h-[62%] w-[62%]">
                {sym === 'seven' && <path d="M10 8h28v7L23 42h-9l14-26H10z" fill="url(#seven-grad)" stroke="#7a1d12" stroke-width="1.5" stroke-linejoin="round" />}
                {sym === 'diamond' && <path d="M24 5l15 15-15 23L9 20z" fill="#4eeabb" />}
                {sym === 'star' && <path d="M24 5l5.6 12.2 13.4 1.4-10 9 2.9 13.2L24 34l-11.9 6.8 2.9-13.2-10-9 13.4-1.4z" fill="#f6cd68" />}
                {sym === 'bar' && <g fill="#9d8cff"><rect x="7" y="14" width="34" height="8" rx="4" /><rect x="7" y="26" width="34" height="8" rx="4" /></g>}
                {sym === 'cherry' && <g><path d="M24 8c-2 8-8 12-10 20M24 8c3 7 8 12 10 20" stroke="#4eeabb" stroke-width="2.5" fill="none" stroke-linecap="round" /><circle cx="14" cy="32" r="7" fill="#ff6b6b" /><circle cx="34" cy="32" r="7" fill="#ff6b6b" /></g>}
              </svg>
            </div>
          ))}
        </div>
      </div>
    ))}
    <div class="winline pointer-events-none absolute inset-x-2 top-1/2 h-[calc((100%-1.5rem)/3)] -translate-y-1/2 rounded-xl border-2 border-gold-400"></div>
    <svg width="0" height="0" class="absolute"><defs><linearGradient id="seven-grad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff8a6b" /><stop offset="1" stop-color="#e5372a" /></linearGradient></defs></svg>
  </div>

  <div class="mt-5 space-y-3 text-center">
    <p class="font-display text-3xl uppercase text-fg">7 · 7 · 7 <span class="text-gold-400">– und los</span></p>
    <p class="text-sm text-muted">Ein Klick, ein zufälliger Slot aus über tausend offiziellen Demos. Mit Spielgeld, ohne Anmeldung.</p>
    <RandomDemoButton label="Zufallsslot spielen" class="!min-h-12 w-full text-base" />
  </div>
</div>

<style>
  .hero-reels { --cell: 5.25rem; }
  @media (max-width: 640px) { .hero-reels { --cell: 4.25rem; } }
  .reel-window { height: calc(var(--cell) * 3); }
  .reel-cell { height: var(--cell); }
  .reel-strip { will-change: transform; transform: translateY(calc(var(--cell) * -15)); }
  .reel-1 { animation: spin-1 6s cubic-bezier(.2,.75,.25,1) infinite; }
  .reel-2 { animation: spin-2 6s cubic-bezier(.2,.75,.25,1) infinite; }
  .reel-3 { animation: spin-3 6s cubic-bezier(.2,.75,.25,1) infinite; }
  @keyframes spin-1 { 0% { transform: translateY(0); filter: blur(2px); } 22% { filter: blur(0); } 25%, 100% { transform: translateY(calc(var(--cell) * -15)); } }
  @keyframes spin-2 { 0% { transform: translateY(0); filter: blur(2px); } 30% { filter: blur(0); } 33%, 100% { transform: translateY(calc(var(--cell) * -15)); } }
  @keyframes spin-3 { 0% { transform: translateY(0); filter: blur(2px); } 38% { filter: blur(0); } 41%, 100% { transform: translateY(calc(var(--cell) * -15)); } }
  .winline { opacity: 0; animation: win 6s ease-out infinite; box-shadow: 0 0 24px rgb(246 205 104 / .55), inset 0 0 18px rgb(246 205 104 / .25); }
  @keyframes win { 0%, 42% { opacity: 0; } 46%, 90% { opacity: 1; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .reel-1, .reel-2, .reel-3 { animation: none; }
    .winline { animation: none; opacity: 1; }
  }
</style>
