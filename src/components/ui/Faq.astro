---
/** Accordion FAQ. Pass the same items to faqSchema() in the page's jsonLd. */
interface Props { items: { q: string; a: string }[]; title?: string; id?: string }
const { items, title = 'Häufige Fragen', id = 'faq' } = Astro.props;
---
<section aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="text-2xl font-bold text-fg sm:text-3xl">{title}</h2>
  <div class="mt-6 space-y-3">
    {items.map((f) => (
      <details class="card group p-0 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold text-fg">
          <h3 class="font-sans text-base font-semibold tracking-normal">{f.q}</h3>
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line text-mint-400 transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="px-5 pb-5 text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</section>
