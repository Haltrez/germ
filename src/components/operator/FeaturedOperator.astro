---
/** "Unsere Empfehlung" card for the hero (GGL-verified featured operator only). */
import type { CollectionEntry } from 'astro:content';
import OperatorCta from '../compliance/OperatorCta.astro';
interface Props { op: CollectionEntry<'operators'> }
const { op } = Astro.props;
const d = op.data;
---
<div class="card rounded-[1.6rem] border-gold-500/40 p-6">
  <p class="text-center text-xs font-bold uppercase tracking-[0.18em] text-gold-400">Unsere Empfehlung</p>
  <div class="mt-4 flex h-36 items-center justify-center rounded-2xl bg-ink-950/80 font-display text-4xl uppercase text-fg">{d.name}</div>
  <p class="mt-4 text-center font-display text-4xl uppercase text-fg">{d.name}</p>
  {d.strengthTag && <p class="text-center text-muted">Stark bei: {d.strengthTag}</p>}
  <ul class="mt-4 space-y-2 text-sm text-fg">
    {d.pros.slice(0, 3).map((p) => <li class="flex gap-2"><span class="text-mint-400">✔</span>{p}</li>)}
  </ul>
  {d.bonusText !== 'TODO' && (
    <div class="mt-4 rounded-xl border border-line bg-ink-950/60 p-3">
      <p class="text-[0.7rem] font-bold uppercase tracking-wider text-gold-400">Angebot</p>
      <p class="font-bold text-fg">{d.bonusText}</p>
    </div>
  )}
  <OperatorCta slug={op.id} operator={d} class="mt-5 w-full" />
  <p class="mt-2 text-center text-xs text-subtle"><span class="badge-ggl">GGL-Lizenz {d.licenseNumber}</span></p>
</div>
