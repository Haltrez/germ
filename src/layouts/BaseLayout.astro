---
import '../styles/global.css';
import RgBlock from '../components/compliance/RgBlock.astro';
import CookieConsent from '../components/compliance/CookieConsent.astro';
import VercelAnalytics from '../components/compliance/VercelAnalytics.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import MobileBar from '../components/layout/MobileBar.astro';
import { SITE_NAME, SITE_URL, SITE_OG_LOCALE, DEFAULT_OG_IMAGE } from '../config/site.ts';
import { NOINDEX_PATHS } from '../config/routes.ts';
import type { ComplianceContext } from '../lib/compliance.ts';
import { breadcrumbSchema, absUrl, type Crumb, type JsonLd } from '../lib/schema.ts';

interface Props {
  /** Full <title>, max. 60 characters. */
  title: string;
  /** Meta description, max. 155 characters. */
  description: string;
  /** Breadcrumb trail without "Startseite" (added automatically). Omit on the homepage. */
  breadcrumbs?: Crumb[];
  jsonLd?: JsonLd[];
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** "informational" allows neutral mentions of illegal offers / "Online Casino"; forbids affiliate links. */
  complianceContext?: ComplianceContext;
  /** Slot name for the mobile 'Demo spielen' bar on slot pages. */
  mobileSlot?: string;
  /** Show the large responsible-gambling block above the footer (homepage). */
  showRgBlock?: boolean;
  /** @deprecated kept for compatibility */
  hideRgBlock?: boolean;
}

const {
  title,
  description,
  breadcrumbs,
  jsonLd = [],
  noindex = false,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  complianceContext = 'standard',
  showRgBlock = false,
  mobileSlot,
} = Astro.props;

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, SITE_URL).href;
const robotsNoindex = noindex || NOINDEX_PATHS.has(path);
const crumbs: Crumb[] | null = breadcrumbs ? [{ name: 'Startseite', href: '/' }, ...breadcrumbs] : null;
const ld = [...(crumbs ? [breadcrumbSchema(crumbs)] : []), ...jsonLd];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsNoindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#050a1c" />
    <meta name="compliance-context" content={complianceContext} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`Neue Slots – ${SITE_NAME}`} href="/rss.xml" />

    <meta property="og:locale" content={SITE_OG_LOCALE} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absUrl(ogImage)} />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="flex min-h-dvh flex-col pb-16 md:pb-0">
    <a href="#main" class="sr-only z-[60] rounded-lg bg-mint-400 px-4 py-2 font-semibold text-mint-950 focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Zum Inhalt springen</a>
    <Header />
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {showRgBlock && <RgBlock />}
    <Footer />
    <MobileBar slotName={mobileSlot} />
    <CookieConsent />
    <VercelAnalytics />
  </body>
</html>
