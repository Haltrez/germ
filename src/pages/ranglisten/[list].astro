---
/** One ranking list (top 50) from official slot data. */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RANKINGS, rankingRows } from '../../lib/rankings.ts';
import { maxWinText, rtpText, volatilityText } from '../../lib/slots.ts';
import { itemListSchema } from '../../lib/schema.ts';
import { formatDateDE } from '../../lib/i18n/de.ts';

export const getStaticPaths = (() => RANKINGS.map((r) => ({ params: { list: r.slug }, props: { slug: r.slug } }))) satisfies GetStaticPaths;
const r = RANKINGS.find((x) => x.slug === Astro.props.slug)!;
const rows = await rankingRows(r);
const path = `/ranglisten/${r.slug}/`;
const isNew = r.slug === 'neue-slots';
---
<BaseLayout title={r.title} description={r.description} breadcrumbs={[{ name: 'Ranglisten', href: '/ranglisten/' }, { name: r.name, href: path }]} jsonLd={[itemListSchema(r.h1, rows.map((v) => ({ name: v.data.name, path: v.path })))]}>
  <section class="container-site pt-8">
    <p class="eyebrow">Rangliste · Top {rows.length}</p>
    <h1 class="mt-3 text-3xl font-extrabold text-fg sm:text-5xl">{r.h1}</h1>
    <p class="mt-4 max-w-3xl text-muted">{r.intro}</p>
    <p class="mt-3 max-w-3xl rounded-xl border border-line bg-ink-900/60 p-4 text-sm text-muted">{r.note}</p>
    <div class="mt-8 overflow-x-auto rounded-2xl border border-line">
      <table class="w-full min-w-[34rem] text-left text-sm">
        <thead class="bg-ink-900 text-xs uppercase tracking-wider text-subtle">
          <tr><th class="px-3 py-3">#</th><th class="px-3 py-3">Slot</th><th class="px-3 py-3">Hersteller</th><th class="px-3 py-3">{isNew ? 'Erschienen' : 'RTP'}</th><th class="px-3 py-3">Max Win</th><th class="px-3 py-3">Volatilität</th></tr>
        </thead>
        <tbody>
          {rows.map((v, i) => (
            <tr class="border-t border-line hover:bg-ink-900/50">
              <td class="px-3 py-3 font-display text-lg text-gold-400">{i + 1}</td>
              <td class="px-3 py-3"><a href={v.path} class="font-semibold text-fg underline-offset-2 hover:text-gold-300 hover:underline">{v.data.name}</a></td>
              <td class="px-3 py-3 text-muted">{v.provider ? <a href={`/hersteller/${v.provider.id}/`} class="hover:text-fg">{v.provider.data.name}</a> : '–'}</td>
              <td class="px-3 py-3 font-semibold text-fg">{isNew ? formatDateDE(String(v.data.releaseDate)) : rtpText(v.data)}</td>
              <td class="px-3 py-3 text-muted">{maxWinText(v.data)}</td>
              <td class="px-3 py-3 text-muted">{volatilityText(v.data)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="prose-site mt-10">
      <h2>So entsteht die Rangliste</h2>
      <p>
        Grundlage sind die Daten, die die Hersteller zu ihren Spielen veröffentlichen. Aufgenommen werden nur Slots, die bei uns
        als kostenlose Demo spielbar sind. Fehlt eine Angabe des Herstellers, erscheint der Slot nicht in dieser Liste. Begriffe
        wie <a href="/glossar/rtp/">RTP</a>, <a href="/glossar/volatilitaet/">Volatilität</a> und
        {' '}<a href="/glossar/max-win/">Max Win</a> erklärt das Glossar.
      </p>
      <h2>Weitere Ranglisten</h2>
      <ul>{RANKINGS.filter((x) => x.slug !== r.slug).map((x) => <li><a href={`/ranglisten/${x.slug}/`}>{x.h1}</a></li>)}</ul>
    </div>
  </section>
</BaseLayout>
