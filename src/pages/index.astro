---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/ui/Faq.astro';
import { CATEGORIES } from '../config/routes.ts';
import { COMPLIANCE } from '../config/site.ts';
import { isPromotable } from '../lib/compliance.ts';
import { organizationSchema, websiteSchema, faqSchema } from '../lib/schema.ts';

const [slots, providers, operators] = await Promise.all([
  getCollection('slots'),
  getCollection('providers'),
  getCollection('operators'),
]);
const slotCount = slots.length;
const stats = [
  { value: slotCount, label: 'kostenlose Demo-Slots' },
  { value: providers.length, label: 'Hersteller' },
  { value: operators.filter((o) => isPromotable(o.data)).length, label: 'Spielotheken mit GGL-Lizenz im Vergleich' },
];

// Title adapts to the real slot count once the library is large enough (≤ 60 chars).
const title = slotCount >= 50
  ? `Kostenlose Spielautomaten – ${Math.floor(slotCount / 50) * 50}+ Slots gratis spielen`
  : 'Kostenlose Spielautomaten – gratis spielen ohne Anmeldung';
const description =
  'Kostenlose Spielautomaten ohne Anmeldung: Spielgeld-Demos, echte Herstellerdaten zu RTP und Max-Win und nur GGL-lizenzierte Spielotheken.';

const chips = [
  ...CATEGORIES.filter((c) => c.code !== 'fruit').map((c) => ({ label: c.short, href: `/kategorien/${c.slug}/` })),
  { label: 'Neu', href: '/ranglisten/neue-slots/' },
];

const method = [
  { n: '01', title: 'Lizenz prüfen', text: 'Wir nehmen nur Spielotheken auf, die auf der offiziellen Whitelist der GGL stehen, und prüfen das regelmäßig erneut.' },
  { n: '02', title: 'Daten belegen', text: 'RTP, Volatilität und Maximalgewinn stammen aus den offiziellen Spieldatenblättern der Hersteller – mit Quelle.' },
  { n: '03', title: 'Selbst testen', text: 'Wir spielen die Demos selbst und prüfen bei Spielotheken Einzahlung, Auszahlung und Kundenservice.' },
  { n: '04', title: 'Ehrlich bewerten', text: 'Unsere Bewertung folgt festen Kriterien. Provisionen haben keinen Einfluss auf Reihenfolge oder Urteil.' },
];

const rules = [
  { value: `${COMPLIANCE.maxStakePerSpinEur} €`, label: 'Höchsteinsatz pro Spin', text: 'Bei legalen Online-Spielotheken darfst du pro Drehung maximal 1 € setzen.' },
  { value: `${COMPLIANCE.minSecondsPerSpin} Sek.`, label: 'Mindestdauer pro Runde', text: 'Zwischen zwei Spins müssen mindestens fünf Sekunden liegen. Autoplay ist nicht erlaubt.' },
  { value: `${COMPLIANCE.lugasDefaultMonthlyDepositLimitEur.toLocaleString('de-DE')} €`, label: 'Einzahlungslimit pro Monat', text: 'Das Limit gilt anbieterübergreifend und wird über das System LUGAS überwacht.' },
  { value: 'OASIS', label: 'Spielersperre', text: 'Über das bundesweite Sperrsystem kannst du dich für alle legalen Anbieter sperren lassen.' },
];

const faq = [
  {
    q: 'Kann ich die Spielautomaten wirklich kostenlos und ohne Anmeldung spielen?',
    a: 'Ja. Die Demos laufen mit Spielgeld direkt in deinem Browser. Du brauchst kein Kundenkonto, musst nichts einzahlen und nichts herunterladen. Spielgeld kann nicht ausgezahlt werden.',
  },
  {
    q: 'Kann ich in den Demo-Versionen echtes Geld gewinnen?',
    a: 'Nein. In der Demo setzt und gewinnst du nur Spielgeld ohne Wert. Sie ist dafür da, Regeln, Funktionen und das Spielgefühl eines Slots kennenzulernen, ohne Geld zu riskieren.',
  },
  {
    q: 'Spielt sich die Demo genauso wie die Echtgeld-Version?',
    a: 'Die Spielmechanik ist in der Regel dieselbe. Bei lizenzierten Anbietern in Deutschland gelten aber zusätzliche Regeln, etwa höchstens 1 € Einsatz pro Spin und mindestens 5 Sekunden pro Runde. Manche Slots gibt es außerdem in mehreren RTP-Versionen – wir geben an, welche uns bekannt sind.',
  },
  {
    q: 'Ist das Spielen an Online-Spielautomaten in Deutschland legal?',
    a: 'Seit dem Glücksspielstaatsvertrag 2021 ist virtuelles Automatenspiel bei Anbietern mit einer Erlaubnis der Gemeinsamen Glücksspielbehörde der Länder (GGL) legal. Welche Anbieter das sind, steht auf der offiziellen Whitelist der GGL. Wir vergleichen ausschließlich solche Anbieter.',
  },
  {
    q: 'Wie finanziert sich diese Seite?',
    a: 'Über Provisionen: Wenn du über einen gekennzeichneten Link zu einer lizenzierten Spielothek gehst und dich dort anmeldest, erhalten wir möglicherweise eine Vergütung. Für dich entstehen keine Kosten, und unsere Daten und Bewertungen bleiben davon unberührt.',
  },
];
---
<BaseLayout {title} {description} jsonLd={[organizationSchema(), websiteSchema(), faqSchema(faq)]}>
  <!-- Hero -->
  <section class="container-site grid items-center gap-10 pb-8 pt-10 sm:pt-14 lg:grid-cols-[1.25fr_1fr] lg:pt-20">
    <div>
      <p class="eyebrow">Spielgeld-Demos · ohne Anmeldung · ohne Download</p>
      <h1 class="mt-4 text-4xl font-extrabold text-fg sm:text-5xl lg:text-6xl">
        Kostenlose Spielautomaten <span class="text-mint-400">gratis spielen</span> – ohne Anmeldung
      </h1>
      <p class="mt-5 max-w-xl text-lg text-muted">
        Hier probierst du kostenlose Spielautomaten direkt im Browser aus: mit Spielgeld, ohne Konto und ohne Einzahlung.
        Zu jedem Slot bekommst du die offiziellen Werte des Herstellers – RTP, Volatilität und Maximalgewinn – verständlich erklärt.
      </p>

      <form action="/spielautomaten/" method="get" role="search" class="mt-8 max-w-xl">
        <label for="hero-search" class="sr-only">Slot suchen</label>
        <div class="flex items-center gap-2 rounded-full border border-ink-600 bg-ink-900/80 p-1.5 pl-5 shadow-[var(--shadow-card)] focus-within:border-mint-400">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0 text-subtle"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none" /><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <input id="hero-search" name="q" type="search" autocomplete="off" placeholder="Slot oder Hersteller suchen, z. B. Book of Ra" class="min-w-0 flex-1 bg-transparent py-2.5 text-base text-fg placeholder:text-subtle focus:outline-none" />
          <button type="submit" class="btn btn-primary shrink-0">Suchen</button>
        </div>
      </form>

      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Kategorien">
        {chips.map((c) => (<li><a href={c.href} class="chip">{c.label}</a></li>))}
      </ul>
    </div>

    <!-- Decorative reels (original artwork, no game assets) -->
    <div class="relative mx-auto hidden w-full max-w-md lg:block" aria-hidden="true">
      <div class="absolute inset-0 -z-10 rounded-[2rem] bg-gradient-to-br from-mint-500/25 via-violet-500/20 to-transparent blur-2xl"></div>
      <div class="card rounded-[2rem] p-5">
        <div class="grid grid-cols-3 gap-3">
          {[
            ['diamond', 'star', 'bar'],
            ['seven', 'diamond', 'star'],
            ['bar', 'seven', 'diamond'],
          ].map((reel) => (
            <div class="space-y-3 rounded-2xl bg-ink-950/70 p-2.5">
              {reel.map((sym, i) => (
                <div class:list={['flex aspect-square items-center justify-center rounded-xl border', i === 1 ? 'border-mint-400/60 bg-mint-400/10' : 'border-line bg-ink-850']}>
                  <svg viewBox="0 0 48 48" class="h-3/5 w-3/5">
                    {sym === 'diamond' && <path d="M24 5l15 15-15 23L9 20z" fill="#4eeabb" />}
                    {sym === 'star' && <path d="M24 5l5.6 12.2 13.4 1.4-10 9 2.9 13.2L24 34l-11.9 6.8 2.9-13.2-10-9 13.4-1.4z" fill="#ffc857" />}
                    {sym === 'bar' && <g fill="#9d8cff"><rect x="7" y="14" width="34" height="8" rx="4" /><rect x="7" y="26" width="34" height="8" rx="4" /></g>}
                    {sym === 'seven' && <path d="M11 9h26v6L23 41h-8l13-24H11z" fill="#ff8a80" />}
                  </svg>
                </div>
              ))}
            </div>
          ))}
        </div>
        <div class="mt-4 flex items-center justify-between rounded-xl bg-ink-950/60 px-4 py-3 text-sm">
          <span class="text-subtle">Spielgeld</span>{' '}
          <span class="font-display font-bold text-fg">Demo · kein Echtgeld</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="container-site" aria-label="Zahlen">
    <dl class="grid gap-3 sm:grid-cols-3">
      {stats.map((s) => (
        <div class="card flex items-baseline gap-3 p-5">
          <dt class="sr-only">{s.label}</dt>
          <dd class="font-display text-3xl font-extrabold text-gold-400">{s.value > 0 ? s.value.toLocaleString('de-DE') : '–'}</dd>
          <dd class="text-sm text-muted">{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Trust / method -->
  <section class="container-site mt-20" aria-labelledby="trust-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">So arbeiten wir</p>
        <h2 id="trust-title" class="mt-2 text-3xl font-bold text-fg sm:text-4xl">Warum du uns vertrauen kannst</h2>
      </div>
      <a href="/bewertungsmethodik/" class="btn btn-secondary">Zur Bewertungsmethodik</a>
    </div>
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {method.map((m) => (
        <li class="card p-6">
          <span class="font-display text-sm font-extrabold text-mint-400">{m.n}</span>
          <h3 class="mt-3 text-xl font-bold text-fg">{m.title}</h3>
          <p class="mt-2 text-sm text-muted">{m.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- German rules -->
  <section class="container-site mt-20" aria-labelledby="rules-title">
    <p class="eyebrow">Spielerschutz in Deutschland</p>
    <h2 id="rules-title" class="mt-2 text-3xl font-bold text-fg sm:text-4xl">Diese Regeln gelten bei legalen Online-Spielotheken</h2>
    <p class="mt-3 max-w-2xl text-muted">
      Der Glücksspielstaatsvertrag 2021 legt für virtuelle Automatenspiele klare Grenzen fest. In unseren Spielgeld-Demos
      gelten sie nicht, beim Echtgeldspiel in Deutschland schon. Gut zu wissen, bevor du dich für eine Spielothek entscheidest:
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {rules.map((r) => (
        <div class="card p-6">
          <p class="font-display text-3xl font-extrabold text-fg">{r.value}</p>
          <p class="mt-1 text-sm font-semibold text-mint-300">{r.label}</p>
          <p class="mt-3 text-sm text-muted">{r.text}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-sm">
      <a href="/verantwortungsvoll-spielen/" class="text-mint-300 underline underline-offset-2 hover:text-mint-400">Mehr zu OASIS, LUGAS und Limits</a>
    </p>
  </section>

  <!-- FAQ -->
  <div class="container-site mt-20 max-w-4xl">
    <Faq items={faq} title="Häufige Fragen zu kostenlosen Spielautomaten" />
  </div>
</BaseLayout>
