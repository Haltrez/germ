---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/ui/Faq.astro';
import HeroReels from '../components/ui/HeroReels.astro';
import Lobby from '../components/slot/Lobby.astro';
import FeaturedOperator from '../components/operator/FeaturedOperator.astro';
import OperatorRanking from '../components/operator/OperatorRanking.astro';
import { CATEGORIES, isLive } from '../config/routes.ts';
import { COMPLIANCE } from '../config/site.ts';
import { isPromotable } from '../lib/compliance.ts';
import { getSlotViews, rtpMax, rtpText, volatilityText } from '../lib/slots.ts';
import { organizationSchema, websiteSchema, faqSchema } from '../lib/schema.ts';

const [views, providers, operators] = await Promise.all([getSlotViews(), getCollection('providers'), getCollection('operators')]);
const ops = operators
  .filter((o) => isPromotable(o.data))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.rating?.total ?? 0) - (a.data.rating?.total ?? 0));
const featured = ops.find((o) => o.data.featured) ?? ops[0];
const reviewed = views.filter((v) => v.indexable);
const slotCount = views.length;
const n = (x: number) => x.toLocaleString('de-DE');

const title = slotCount >= 50
  ? `Kostenlose Spielautomaten – ${n(Math.floor(slotCount / 100) * 100)}+ Slots gratis spielen`
  : 'Kostenlose Spielautomaten – gratis spielen ohne Anmeldung';
const description =
  'Kostenlose Spielautomaten ohne Anmeldung: über 1.000 offizielle Slot-Demos, echte Herstellerdaten zu RTP & Max Win und nur GGL-lizenzierte Spielotheken.';

const chips = [
  ...['hold-and-win', 'book', 'megaways', 'bonus-buy', 'classic'].map((code) => CATEGORIES.find((c) => c.code === code)!)
    .map((c) => ({ label: c.short, href: `/kategorien/${c.slug}/` })),
];
const stats = [
  { v: n(slotCount), t: 'Slots kostenlos spielbar' },
  { v: String(providers.length), t: 'Hersteller' },
];

const spotlightIds = ['gates-of-olympus', 'book-of-dead', 'starburst', 'le-bandit'];
const spotlight = spotlightIds.map((id) => views.find((v) => v.id === id)).filter((v) => v?.indexable) as typeof views;
const rtpTop = reviewed.filter((v) => rtpMax(v.data) !== null).sort((a, b) => rtpMax(b.data)! - rtpMax(a.data)!).slice(0, 6);

const rules = [
  { v: `${COMPLIANCE.maxStakePerSpinEur} €`, t: 'Höchsteinsatz pro Spin bei legalen Online-Spielotheken' },
  { v: `${COMPLIANCE.minSecondsPerSpin} Sek.`, t: 'Mindestdauer pro Spielrunde – kein Autoplay' },
  { v: `${n(COMPLIANCE.lugasDefaultMonthlyDepositLimitEur)} €`, t: 'anbieterübergreifendes Einzahlungslimit pro Monat (LUGAS)' },
  { v: 'OASIS', t: 'bundesweite Spielersperre für alle legalen Anbieter' },
];
const method = [
  { v: '01', t: 'Lizenz prüfen: Wir empfehlen nur Spielotheken von der offiziellen GGL-Whitelist.' },
  { v: '02', t: 'Daten belegen: RTP, Volatilität und Max Win stammen direkt vom Hersteller.' },
  { v: '03', t: 'Selbst testen: Wir spielen die Demos und prüfen Ein- und Auszahlungen.' },
  { v: '04', t: 'Ehrlich bewerten: Feste Kriterien – Provisionen ändern keine Bewertung.' },
];
const faq = [
  { q: 'Kann ich die Spielautomaten wirklich kostenlos und ohne Anmeldung spielen?', a: 'Ja. Die Demos laufen mit Spielgeld direkt in deinem Browser. Du brauchst kein Kundenkonto, musst nichts einzahlen und nichts herunterladen. Spielgeld kann nicht ausgezahlt werden.' },
  { q: 'Woher kommen die Spiele?', a: 'Alle Demos sind offizielle Versionen der Hersteller, zum Beispiel von Pragmatic Play, NetEnt, Play\'n GO, Hacksaw Gaming oder BGaming. Die Spieldaten übernehmen wir aus den offiziellen Angaben der Hersteller.' },
  { q: 'Kann ich in den Demo-Versionen echtes Geld gewinnen?', a: 'Nein. In der Demo setzt und gewinnst du nur Spielgeld ohne Wert. Sie ist dafür da, Regeln, Funktionen und das Spielgefühl eines Slots kennenzulernen.' },
  { q: 'Ist das Spielen an Online-Spielautomaten in Deutschland legal?', a: 'Seit dem Glücksspielstaatsvertrag 2021 ist virtuelles Automatenspiel bei Anbietern mit Erlaubnis der GGL legal. Wir vergleichen ausschließlich solche Anbieter.' },
  { q: 'Was ist der Zufallsslot?', a: 'Ein Klick auf den Würfel öffnet einen zufällig ausgewählten Slot mit offizieller Demo. Ideal, wenn du neue Spiele entdecken willst.' },
];
---
<BaseLayout {title} {description} showRgBlock jsonLd={[organizationSchema(), websiteSchema(), faqSchema(faq)]}>
  <!-- HERO -->
  <section class="border-b border-line">
    <div class="container-site grid items-center gap-10 pb-14 pt-10 sm:pt-14 lg:grid-cols-[1.35fr_1fr] lg:gap-14 lg:pt-20">
      <div class="min-w-0">
        <p class="eyebrow">Offizielle Demos · Echte Daten · Ohne Anmeldung</p>
        <h1 class="mt-4 text-[2.6rem] uppercase text-fg min-[400px]:text-5xl sm:text-6xl lg:text-7xl">
          Kostenlose Spielautomaten <span class="text-gold-400">ohne Anmeldung spielen</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-muted">
          Über {n(Math.floor(slotCount / 100) * 100)} offizielle Slot-Demos von {providers.length} Herstellern – mit Spielgeld, ohne Konto und ohne Einzahlung.
          Zu jedem Spiel bekommst du die Werte direkt vom Hersteller: RTP, Volatilität und Maximalgewinn.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/spielautomaten/" class="btn btn-primary !min-h-14 !px-7 text-lg">Slots kostenlos spielen</a>
          <a href="/echtgeld-spielotheken/" class="btn btn-secondary !min-h-14 !px-7 text-lg">Spielotheken vergleichen</a>
        </div>

        <form action="/spielautomaten/" method="get" role="search" class="mt-6 max-w-xl">
          <label for="hero-search" class="sr-only">Spiel suchen</label>
          <div class="flex items-center gap-2 rounded-2xl border border-ink-600 bg-ink-900/80 p-1.5 pl-4 focus-within:border-gold-400">
            <input id="hero-search" name="q" type="search" autocomplete="off" placeholder="Book of Dead, Sweet Bonanza, Starburst …" class="min-w-0 flex-1 bg-transparent py-3 text-base text-fg placeholder:text-subtle focus:outline-none" />
            <button type="submit" class="btn btn-primary shrink-0 !min-h-12 !px-5">Spiel finden</button>
          </div>
        </form>

        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Kategorien">
          {chips.map((c) => (<li><a href={c.href} class="chip !rounded-xl">{c.label}</a></li>))}
        </ul>

        <dl class="mt-8 grid max-w-md grid-cols-2 overflow-hidden rounded-2xl border border-line bg-ink-900/70">
          {stats.map((s, i) => (
            <div class:list={['p-4', i === 1 && 'border-l border-line']}>
              <dt class="sr-only">{s.t}</dt>
              <dd class="font-display text-3xl text-gold-400">{s.v}</dd>
              <dd class="mt-1 text-xs text-muted">{s.t}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="mx-auto w-full max-w-md">
        {featured ? <FeaturedOperator op={featured} /> : <HeroReels />}
      </div>
    </div>
  </section>

  <!-- TOP 5 -->
  {ops.length > 0 && (
    <section class="container-site pt-16" aria-labelledby="top-title">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="top-title" class="section-title">Top {Math.min(5, ops.length)} Online-Spielotheken im Vergleich</h2>
          <p class="section-sub">Nur Anbieter mit Erlaubnis der GGL – geprüft nach unserer Bewertungsmethodik.</p>
        </div>
        {isLive('/echtgeld-spielotheken/') && <a href="/echtgeld-spielotheken/" class="btn-ghost">Alle im Vergleich</a>}
      </div>
      <OperatorRanking ops={ops.slice(0, 5)} />
    </section>
  )}

  <!-- SPIELHALLE -->
  <section class="container-site pt-16" aria-labelledby="hall-title">
    <h2 id="hall-title" class="section-title">Die Spielhalle</h2>
    <p class="section-sub">{n(slotCount)} Spielautomaten von Book of Dead bis Gates of Olympus. Wähle dein Lieblingsspiel, starte die Demo oder lass den Würfel entscheiden.</p>
    <div class="mt-7"><Lobby pageSize={18} searchId="hall-search" /></div>
    <p class="mt-6 text-center"><a href="/spielautomaten/" class="btn btn-secondary">Alle {n(slotCount)} Spiele in der Spielhalle</a></p>
  </section>

  <!-- CTA: Spielotheken -->
  <section class="container-site mt-16">
    <div class="relative overflow-hidden rounded-3xl border border-gold-500/40 bg-gradient-to-br from-ink-800 via-ink-850 to-ink-900 p-7 sm:p-10">
      <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-gold-400/15 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid gap-6 lg:grid-cols-[1.5fr_auto] lg:items-center">
        <div>
          <p class="eyebrow">Legal · Sicher · Geprüft</p>
          <h2 class="mt-2 section-title">Online-Spielotheken mit deutscher Lizenz</h2>
          <p class="section-sub">Du willst einen Slot mit Echtgeld spielen? Wir vergleichen nur Anbieter von der offiziellen GGL-Whitelist – mit Lizenznummer, Prüfdatum und echten Tests von Ein- und Auszahlung.</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a href="/echtgeld-spielotheken/" class="btn btn-primary !min-h-14 !px-8 text-lg">Spielotheken vergleichen</a>
          <a href="/krypto-spielotheken/" class="btn btn-secondary !min-h-12">Krypto-Spielotheken</a>
        </div>
      </div>
    </div>
  </section>

  <!-- KULT-SLOTS -->
  {spotlight.length > 0 && (
    <section class="band-alt mt-20 py-16" aria-labelledby="kult-title">
      <div class="container-site">
        <h2 id="kult-title" class="section-title">Kult-Slots im Detail</h2>
        <p class="section-sub">Unsere ausführlichen Tests: Regeln, Features, RTP und ehrliche Einschätzung.</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {spotlight.map((v) => (
            <a href={v.path} class="group card flex flex-col overflow-hidden p-0 hover:border-gold-400/60">
              <div class="relative aspect-[16/10] overflow-hidden bg-ink-900">
                {v.data.thumbnail && <img src={v.data.thumbnail.src} alt={v.data.thumbnail.alt} loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gold-400">{v.provider?.data.name}{rtpMax(v.data) !== null && ` · RTP ${rtpText(v.data)}`}</p>
                <p class="mt-2 font-title text-lg font-bold text-fg">{v.data.name} im Test</p>
                <span class="mt-auto pt-3 text-sm font-bold text-gold-300">Zum Test →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- RTP -->
  {rtpTop.length > 0 && (
    <section class="container-site grid gap-8 py-16 lg:grid-cols-[1fr_1.3fr] lg:items-center" aria-labelledby="rtp-title">
      <div>
        <h2 id="rtp-title" class="section-title">Auszahlungsquoten im Vergleich</h2>
        <p class="section-sub">
          Der RTP zeigt, wie viel ein Slot über sehr viele Runden im Schnitt auszahlt. Höher ist besser für dich – aber auch bei 98 %
          behält die Spielothek langfristig einen Teil der Einsätze. Jeder einzelne Spin bleibt Zufall.
        </p>
        <a href="/spielautomaten/?sort=rtp" class="btn-ghost mt-5 inline-block">Alle Slots nach RTP sortieren</a>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-line">
        <table class="w-full min-w-[30rem] text-left text-sm">
          <thead class="bg-ink-900 text-xs uppercase tracking-wider text-subtle">
            <tr><th class="p-3">Slot</th><th class="p-3">Hersteller</th><th class="p-3">RTP</th><th class="p-3">Volatilität</th></tr>
          </thead>
          <tbody>
            {rtpTop.map((v) => (
              <tr class="border-t border-line">
                <td class="p-3 font-semibold"><a href={v.path} class="text-fg hover:text-gold-300">{v.data.name}</a></td>
                <td class="p-3 text-muted">{v.provider?.data.name}</td>
                <td class="p-3"><span class="rounded-md bg-mint-400/15 px-2 py-0.5 font-bold text-mint-300">{rtpText(v.data)}</span></td>
                <td class="p-3 text-muted">{volatilityText(v.data) === 'wird geprüft' ? '–' : volatilityText(v.data)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- SPIELERSCHUTZ -->
  <section class="band-alt py-16" aria-labelledby="rules-title">
    <div class="container-site">
      <h2 id="rules-title" class="section-title">Klare Regeln bei legalen Spielotheken</h2>
      <p class="section-sub">Der Glücksspielstaatsvertrag 2021 schützt dich beim Echtgeldspiel. In unseren Spielgeld-Demos gelten diese Grenzen nicht.</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {rules.map((r) => (<div class="tile"><p class="tile-v">{r.v}</p><p class="tile-t">{r.t}</p></div>))}
      </div>
      <p class="mt-5 text-sm"><a href="/verantwortungsvoll-spielen/" class="btn-ghost">Mehr zu OASIS, LUGAS und Limits</a></p>
    </div>
  </section>

  <!-- TRUST -->
  <section class="container-site py-16" aria-labelledby="trust-title">
    <h2 id="trust-title" class="section-title">Warum du uns vertrauen kannst</h2>
    <p class="section-sub">Vier Schritte, die jede Bewertung durchläuft.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {method.map((m) => (<div class="tile"><p class="tile-v">{m.v}</p><p class="tile-t">{m.t}</p></div>))}
    </div>
    <p class="mt-5 text-sm"><a href="/bewertungsmethodik/" class="btn-ghost">So prüfen wir im Detail</a></p>
  </section>

  <!-- FAQ -->
  <section class="band-alt py-16">
    <div class="container-site max-w-4xl">
      <Faq items={faq} title="Häufige Fragen" />
    </div>
  </section>
</BaseLayout>
