---
/**
 * Crypto page. Lists ONLY GGL-verified operators (isPromotable) that accept crypto.
 * OperatorCta throws for anything else, and the dist audit re-checks every link.
 * With no qualifying operator, the page is an honest explainer without affiliate links.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/ui/Faq.astro';
import OperatorCta from '../components/compliance/OperatorCta.astro';
import AffiliateDisclosure from '../components/compliance/AffiliateDisclosure.astro';
import { isPromotable } from '../lib/compliance.ts';
import { faqSchema } from '../lib/schema.ts';
import { formatDateDE } from '../lib/i18n/de.ts';

const operators = (await getCollection('operators'))
  .filter((o) => isPromotable(o.data) && o.data.paymentMethods.includes('crypto'))
  .sort((a, b) => (b.data.rating?.total ?? 0) - (a.data.rating?.total ?? 0));
const hasOperators = operators.length > 0;
const updated = '2026-11-14';

const faq = [
  {
    q: 'Gibt es legale Krypto Casinos in Deutschland?',
    a: 'Legal ist eine Online-Spielothek in Deutschland nur mit Erlaubnis der Gemeinsamen Glücksspielbehörde der Länder (GGL). Ob ein Anbieter mit Kryptowährungen auch auf der GGL-Whitelist steht, prüfen wir für jeden Eintrag auf dieser Seite. Lizenzen aus anderen Ländern, etwa aus Curaçao, reichen für Deutschland nicht aus.',
  },
  {
    q: 'Ist es strafbar, bei einem Anbieter ohne deutsche Erlaubnis zu spielen?',
    a: 'Ja, die Teilnahme an unerlaubtem Glücksspiel ist in Deutschland nach § 285 StGB strafbar. Zusätzlich fehlen dort Spielerschutz, Einzahlungslimit und die Anbindung an das Sperrsystem OASIS, und Gewinne lassen sich im Streitfall kaum durchsetzen.',
  },
  {
    q: 'Warum findet man kaum Spielotheken mit GGL-Lizenz, die Bitcoin akzeptieren?',
    a: 'Lizenzierte Anbieter müssen jede Einzahlung einem verifizierten Spielerkonto zuordnen und an das System LUGAS melden, damit das monatliche Einzahlungslimit eingehalten wird. Diese Vorgaben lassen sich mit klassischen Zahlungsmitteln deutlich einfacher erfüllen als mit Kryptowährungen.',
  },
  {
    q: 'Wie erkenne ich, ob ein Anbieter eine deutsche Erlaubnis hat?',
    a: 'Such den genauen Namen des Anbieters und seine Internetadresse auf der offiziellen Whitelist der GGL. Steht er dort nicht, hat er keine Erlaubnis für Deutschland – egal, welche Siegel er auf seiner Website zeigt.',
  },
];
---
<BaseLayout
  title="Krypto Casinos in Deutschland: Was mit GGL-Lizenz geht"
  description="Krypto Casinos und Bitcoin-Spielotheken: Welche Anbieter eine deutsche GGL-Erlaubnis haben, welche Risiken es gibt und wie du legale Angebote erkennst."
  breadcrumbs={[{ name: 'Spielotheken', href: '/echtgeld-spielotheken/' }, { name: 'Krypto-Spielotheken', href: '/krypto-spielotheken/' }]}
  jsonLd={[faqSchema(faq)]}
  complianceContext="ggl-crypto"
>
  <article class="container-site pt-8">
    <header class="max-w-3xl">
      <p class="eyebrow">Zahlen mit Bitcoin &amp; Co.</p>
      <h1 class="mt-3 text-3xl font-extrabold text-fg sm:text-5xl">Krypto-Spielotheken mit deutscher Lizenz</h1>
      <p class="mt-4 text-lg text-muted">
        Krypto Casinos werben mit schnellen Zahlungen in Bitcoin, Ethereum oder Tether. Für Spieler in Deutschland zählt aber
        vor allem eins: die Erlaubnis der GGL. Auf dieser Seite zeigen wir dir ausschließlich Anbieter, die Kryptowährungen
        akzeptieren <strong class="text-fg">und</strong> auf der offiziellen GGL-Whitelist stehen.
      </p>
      <p class="mt-4 text-sm text-subtle">Stand: <time datetime={updated}>{formatDateDE(updated)}</time> · <a href="/bewertungsmethodik/" class="underline underline-offset-2 hover:text-fg">So prüfen wir</a></p>
    </header>

    {hasOperators ? (
      <section class="mt-10" aria-labelledby="list-title">
        <h2 id="list-title" class="text-2xl font-bold text-fg sm:text-3xl">Spielotheken mit GGL-Lizenz und Krypto-Zahlung</h2>
        <AffiliateDisclosure class="mt-4 max-w-3xl" />
        <ol class="mt-6 grid gap-4">
          {operators.map((o, i) => (
            <li class="card grid gap-4 p-5 sm:grid-cols-[auto_1fr_auto] sm:items-center">
              <span class="font-display text-2xl font-extrabold text-gold-400">#{i + 1}</span>
              <div>
                <p class="font-display text-xl font-bold text-fg">{o.data.name}</p>
                <p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-muted">
                  <span class="badge-ggl">GGL-Lizenz {o.data.licenseNumber}</span>
                  <span>Whitelist geprüft am {formatDateDE(o.data.gglWhitelistCheckedAt!)}</span>
                </p>
                {o.data.strengthTag && <p class="mt-2 text-sm text-mint-300">Stark bei: {o.data.strengthTag}</p>}
              </div>
              <OperatorCta slug={o.id} operator={o.data} />
            </li>
          ))}
        </ol>
      </section>
    ) : (
      <section class="card mt-10 max-w-3xl p-6" aria-labelledby="status-title">
        <h2 id="status-title" class="text-xl font-bold text-fg">Aktueller Stand unseres Vergleichs</h2>
        <p class="mt-2 text-muted">
          Derzeit ist in unserem Vergleich keine Spielothek mit GGL-Erlaubnis gelistet, die Kryptowährungen akzeptiert. Sobald
          wir einen solchen Anbieter auf der Whitelist bestätigt haben, findest du ihn hier – mit Lizenznummer und Prüfdatum.
        </p>
        <a href="/echtgeld-spielotheken/" class="btn btn-secondary mt-4">Alle Spielotheken mit GGL-Lizenz</a>
      </section>
    )}

    <div class="prose-site mt-12">
      <h2>Was ist ein Krypto Casino?</h2>
      <p>
        So nennt man Online-Spielotheken, bei denen du mit Kryptowährungen einzahlst und dir Gewinne in Kryptowährungen
        auszahlen lässt. Beworben werden meist schnelle Transaktionen und wenig Papierkram. Die allermeisten dieser Angebote
        arbeiten mit Lizenzen aus Ländern wie Curaçao. Diese Lizenzen gelten in Deutschland nicht.
      </p>

      <h2>Warum die deutsche Erlaubnis entscheidend ist</h2>
      <p>Nur bei Anbietern auf der GGL-Whitelist hast du den Schutz, den der Glücksspielstaatsvertrag vorschreibt:</p>
      <ul>
        <li>Abgleich mit dem Sperrsystem OASIS, damit gesperrte Spieler wirklich geschützt sind</li>
        <li>Ein anbieterübergreifendes Einzahlungslimit über LUGAS</li>
        <li>Höchstens 1 € Einsatz pro Spin und mindestens 5 Sekunden pro Runde</li>
        <li>Eine deutsche Aufsichtsbehörde, an die du dich bei Problemen wenden kannst</li>
      </ul>
      <p>
        Bei Anbietern ohne deutsche Erlaubnis fehlt all das. Dazu kommt: Die Teilnahme an unerlaubtem Glücksspiel ist in
        Deutschland strafbar, und Gewinne lassen sich im Streitfall kaum einfordern.
      </p>

      <h2>Besondere Risiken bei Kryptowährungen</h2>
      <ul>
        <li><strong>Kursschwankungen:</strong> Der Wert deines Guthabens kann sich innerhalb von Stunden stark verändern – unabhängig vom Spiel.</li>
        <li><strong>Keine Rückbuchung:</strong> Krypto-Transaktionen lassen sich nicht stornieren. Eine Zahlung an den falschen Anbieter ist weg.</li>
        <li><strong>Steuern und Nachweise:</strong> Der Tausch von Kryptowährungen kann steuerlich relevant sein. Lass dich im Zweifel beraten.</li>
        <li><strong>Budget verlieren:</strong> Wer in Coins statt in Euro denkt, verliert leichter den Überblick über die echten Kosten.</li>
      </ul>

      <h2>So prüfst du einen Anbieter selbst</h2>
      <ol>
        <li>Öffne die offizielle Whitelist auf der Website der <a href="https://www.gluecksspiel-behoerde.de/" target="_blank" rel="noopener">Gemeinsamen Glücksspielbehörde der Länder</a>.</li>
        <li>Suche nach dem genauen Namen des Anbieters und vergleiche die Internetadresse.</li>
        <li>Steht der Anbieter nicht auf der Liste, hat er keine Erlaubnis für Deutschland.</li>
      </ol>
      <p>
        Wenn du schnell und sicher zahlen möchtest, schau dir die Zahlungsmethoden der
        <a href="/echtgeld-spielotheken/">Spielotheken mit GGL-Lizenz</a> an. Und probier Slots vorher kostenlos mit Spielgeld aus.
      </p>
    </div>

    <div class="mt-16 max-w-4xl">
      <Faq items={faq} title="Häufige Fragen zu Krypto Casinos" />
    </div>
  </article>
</BaseLayout>
