---
/**
 * Crypto page: offshore operators (src/data/offshore-operators.ts) in the same card style as
 * the /echtgeld-spielotheken/ ranking, plus empty placeholder cards. The offshore disclaimer
 * ([data-offshore-disclaimer]) is required by the dist audit for these affiliate links.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { OFFSHORE_OPERATORS } from '../data/offshore-operators.ts';
import { AFFILIATE_REL } from '../lib/compliance.ts';

const TOTAL_SLOTS = 5;
const placeholders = Array.from({ length: Math.max(0, TOTAL_SLOTS - OFFSHORE_OPERATORS.length) }, (_, i) => OFFSHORE_OPERATORS.length + i + 1);
---
<BaseLayout
  title="Krypto-Spielotheken im Vergleich"
  description="Krypto-Spielotheken im Vergleich: Online-Spielotheken, bei denen du mit Bitcoin, Ethereum und anderen Kryptowährungen zahlen kannst."
  breadcrumbs={[{ name: 'Spielotheken', href: '/echtgeld-spielotheken/' }, { name: 'Krypto-Spielotheken', href: '/krypto-spielotheken/' }]}
  complianceContext="ggl-crypto"
>
  <section class="container-site pt-6 pb-14">
    <h1 class="mt-3 section-title !text-[clamp(2.2rem,5vw,3.75rem)]">Krypto-Spielotheken</h1>

    <div class="card mt-6 border-gold-500/40 p-4 text-sm text-muted sm:p-5" data-offshore-disclaimer role="note">
      <p class="font-bold text-fg">Hinweis: Offshore-Anbieter</p>
      <p class="mt-1">
        Die hier gelisteten Anbieter sind Offshore-Anbieter mit einer Lizenz aus Curaçao. Sie haben keine deutsche
        Glücksspiellizenz und richten sich nicht an Spieler mit Wohnsitz in Deutschland. Prüfe vor der Anmeldung, ob die
        Teilnahme in deinem Land erlaubt ist. Es gelten die Bonusbedingungen des jeweiligen Anbieters. Spielen ab 18 Jahren.
      </p>
    </div>

    <ol class="mt-8 space-y-5">
      {OFFSHORE_OPERATORS.map((o, i) => (
        <li class:list={['card relative grid gap-5 p-5 sm:p-6 lg:grid-cols-[auto_auto_1fr_20rem] lg:items-center', i === 0 && 'border-gold-500/60']}>
          <span class:list={['font-display text-6xl', i === 0 ? 'text-gold-400' : 'text-transparent [-webkit-text-stroke:1.5px_var(--color-gold-500)]']}>{i + 1}</span>
          <div class="flex h-24 w-28 items-center justify-center overflow-hidden rounded-2xl bg-ink-950 p-2 text-center font-title font-bold text-fg">{o.name}</div>
          <div>
            <h2 class="font-display text-3xl uppercase text-fg">{o.name}</h2>
            <p class="mt-2"><span class="inline-block rounded-md border border-line px-2 py-0.5 text-xs text-muted">{o.license}</span></p>
          </div>
          <div class="space-y-2">
            <div class="rounded-xl border border-line bg-ink-950/60 p-3">
              <p class="text-[0.7rem] font-bold uppercase tracking-wider text-gold-400">Angebot</p>
              <p class="font-bold text-fg">{o.bonusText}</p>
              {o.bonusNote && <p class="text-sm text-muted">{o.bonusNote}</p>}
            </div>
            <span class="flex flex-col items-stretch gap-1">
              <a href={o.affiliateUrl} rel={AFFILIATE_REL} target="_blank" data-affiliate={o.id} class="btn btn-primary w-full">
                Zum Anbieter<span class="sr-only"> (öffnet {o.name} in neuem Tab, Affiliate-Link)</span>
              </a>
              <span class="text-center text-[0.6875rem] text-subtle" data-affiliate-disclosure>Anzeige</span>
            </span>
          </div>
        </li>
      ))}
      {placeholders.map((n) => (
        <li class="card relative grid gap-5 p-5 sm:p-6 lg:grid-cols-[auto_auto_1fr_20rem] lg:items-center">
          <span class="font-display text-6xl text-transparent [-webkit-text-stroke:1.5px_var(--color-gold-500)]">{n}</span>
          <div class="h-24 w-28 rounded-2xl bg-ink-950" aria-hidden="true"></div>
          <div class="space-y-3" aria-hidden="true">
            <div class="h-7 w-48 max-w-full rounded-md bg-ink-950"></div>
            <div class="h-4 w-36 max-w-full rounded bg-ink-950/70"></div>
          </div>
          <div class="space-y-2" aria-hidden="true">
            <div class="rounded-xl border border-line bg-ink-950/60 p-3">
              <div class="h-3 w-16 rounded bg-gold-400/30"></div>
              <div class="mt-2 h-4 w-40 max-w-full rounded bg-ink-950"></div>
            </div>
            <div class="h-12 w-full rounded-xl border border-line bg-ink-950/40"></div>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
