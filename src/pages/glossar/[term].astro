---
/** A single glossary term (MDX in src/content/glossar). */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absUrl } from '../../lib/schema.ts';
import { formatDateDE } from '../../lib/i18n/de.ts';

export const getStaticPaths = (async () => {
  const all = await getCollection('glossary');
  return all.map((t) => ({ params: { term: t.id }, props: { entry: t, all } }));
}) satisfies GetStaticPaths;

const { entry, all } = Astro.props;
const t = entry.data;
const { Content } = await render(entry);
const path = `/glossar/${entry.id}/`;
const related = t.related.map((r) => all.find((x) => x.id === r)).filter((x) => !!x);
const sorted = [...all].sort((a, b) => a.data.term.localeCompare(b.data.term, 'de'));
const i = sorted.findIndex((x) => x.id === entry.id);
const prev = sorted[i - 1];
const next = sorted[i + 1];
const title = `${t.term}: Bedeutung bei Spielautomaten`;
---
<BaseLayout
  title={title.length <= 60 ? title : `${t.term} einfach erklärt`}
  description={t.short}
  breadcrumbs={[{ name: 'Glossar', href: '/glossar/' }, { name: t.term, href: path }]}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.short,
    url: absUrl(path),
    inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'Slot-Glossar', url: absUrl('/glossar/') },
  }]}
>
  <article class="container-site pb-4 pt-8">
    <header class="max-w-3xl">
      <p class="eyebrow">Slot-Glossar</p>
      <h1 class="mt-3 text-3xl font-extrabold text-fg sm:text-5xl">{t.term}</h1>
      <p class="mt-4 text-lg text-muted">{t.short}</p>
      <p class="mt-3 text-sm text-subtle">Stand: <time datetime={t.updated}>{formatDateDE(t.updated)}</time></p>
    </header>
    <div class="prose-site mt-8"><Content /></div>
    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="section-title">Verwandte Begriffe</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => (
            <a href={`/glossar/${r!.id}/`} class="card block p-5 transition hover:border-gold-500/60">
              <p class="font-title text-lg font-bold text-fg">{r!.data.term}</p>
              <p class="mt-1.5 text-sm text-muted">{r!.data.short}</p>
            </a>
          ))}
        </div>
      </section>
    )}
    <nav class="mt-10 flex flex-wrap justify-between gap-3 text-sm" aria-label="Weitere Begriffe">
      {prev ? <a href={`/glossar/${prev.id}/`} class="text-mint-300 underline underline-offset-2">← {prev.data.term}</a> : <span />}
      <a href="/glossar/" class="text-mint-300 underline underline-offset-2">Alle Begriffe</a>
      {next ? <a href={`/glossar/${next.id}/`} class="text-mint-300 underline underline-offset-2">{next.data.term} →</a> : <span />}
    </nav>
  </article>
</BaseLayout>
