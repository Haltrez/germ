---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lobby from '../../components/slot/Lobby.astro';
import { getSlotViews } from '../../lib/slots.ts';
import { itemListSchema } from '../../lib/schema.ts';

const all = await getSlotViews();
const reviewed = all.filter((v) => v.indexable);
const providers = new Set(all.map((v) => v.data.provider)).size;
---
<BaseLayout
  title="Spielautomaten kostenlos spielen – alle Slots im Überblick"
  description={`Alle ${all.length.toLocaleString('de-DE')} Spielautomaten kostenlos spielen: Demos ohne Anmeldung von ${providers} Herstellern, filterbar nach Kategorie, mit RTP-Angaben.`}
  breadcrumbs={[{ name: 'Spielautomaten', href: '/spielautomaten/' }]}
  jsonLd={reviewed.length ? [itemListSchema('Spielautomaten mit ausführlichem Test', reviewed.slice(0, 50).map((v) => ({ name: v.data.name, path: v.path })))] : []}
>
  <section class="container-site pt-6">
    <h1 class="section-title">Die Spielhalle</h1>
    <p class="section-sub">
      {all.length.toLocaleString('de-DE')} Spielautomaten von {providers} Herstellern kostenlos mit Spielgeld spielen – ohne Anmeldung, ohne Download, ohne Einzahlung.
    </p>
    <div class="mt-8"><Lobby pageSize={36} filters /></div>

    <div class="mx-auto max-w-3xl pt-14 text-muted">
      <h2 class="text-3xl text-fg">Slots kostenlos spielen: So funktioniert die Spielhalle</h2>
      <p class="mt-3">
        Filtere nach Kategorie, Hersteller oder Volatilität und sortiere nach Auszahlungsquote (RTP) oder Maximalgewinn.
        Alle Werte stammen aus den offiziellen Angaben der Hersteller. Die Demos laufen mit Spielgeld – ohne Konto und ohne Risiko.
        Keine Idee, was du spielen willst? Dann lass den Würfel-Tipp entscheiden.
      </p>
    </div>
  </section>
</BaseLayout>
